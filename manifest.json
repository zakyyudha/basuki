{
  "manifest_version": 3,
  "name": "Basuki",
  "version": "3.0.0",
  "description": "Basuki is a Chrome extension designed to help developers with API testing, debugging, and development workflows. This tool allows you to redirect API requests, mock responses, and create isolated browser sessions for different environments.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "notifications",
    "contextMenus",
    "cookies",
    "scripting",
    "tabs",
    "windows"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/intercept.js",
        "intercept.js",
        "chunks/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "128": "images/icon_disabled.png"
  },
  "host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; script-src-elem 'self'; object-src 'self';"
  }
}
